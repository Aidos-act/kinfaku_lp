# Apache: force clean root URL (no /index.html in address bar)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect /index.html to /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L,NE]

  # Optional: redirect trailing slash duplicates (adjust if needed)
  # RewriteCond %{REQUEST_FILENAME} !-d
  # RewriteRule ^(.+)/$ /$1 [R=301,L]
</IfModule>

# Default document (usually already set on shared hosting)
DirectoryIndex index.html
