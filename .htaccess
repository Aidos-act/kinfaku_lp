# Apache: LP deployed under https://example.com/kinfaku/
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /kinfaku/

  # Redirect /kinfaku/index.html to /kinfaku/
  RewriteCond %{THE_REQUEST} \s/kinfaku/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ /kinfaku/ [R=301,L,NE]
</IfModule>

# Default document (usually already set on shared hosting)
DirectoryIndex index.html
